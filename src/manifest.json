{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "0.1.0",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "@ariafox",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "downloads",
    "cookies",
    "storage",
    "notifications",
    "menus"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://[::1]/*"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "icons": {
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "__MSG_extName__"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-capture": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "__MSG_cmdToggleCapture__"
    },
    "open-manager": {
      "suggested_key": { "default": "Alt+A" },
      "description": "__MSG_cmdOpenManager__"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "magnet",
      "name": "AriaFox",
      "uriTemplate": "/manager/index.html#magnet=%s"
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; connect-src 'self' http: https: ws: wss:; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
  }
}
